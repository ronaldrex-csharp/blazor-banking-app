@using CoreBankingApplication.Application.Services
@inject AuthService AuthService
@inject NavigationManager Nav
@implements IDisposable

<nav class="top-nav">
    <div class="nav-left">
        <NavLink class="nav-link" href="/">Home</NavLink>
        <NavLink class="nav-link test-link" href="/accounts">Accounts</NavLink>
    </div>

    <div class="nav-right">
        @if (AuthService.IsAuthenticated)
        {
            <button type="button" class="nav-btn" @onclick="Logout">
                Logout (@AuthService.Username)
            </button>
        }
        else
        {
            <NavLink class="nav-btn" href="/login">Login</NavLink>
        }
    </div>
</nav>

@code {
    protected override void OnInitialized()
    {
        AuthService.OnChange += OnAuthChanged;
    }

    private void OnAuthChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthService.OnChange -= OnAuthChanged;
    }

    private void Logout()
    {
        AuthService.Logout();
        Nav.NavigateTo("/");
    }
}